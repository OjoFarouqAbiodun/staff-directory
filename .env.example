# Copy to .env (which is git-ignored) and fill in your values.
# Real environment variables always override this file.
#
# PostgreSQL target (Supabase Session Pooler). Percent-encode reserved
# characters in the password. This value is a secret: never commit it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# TLS is verified by default. DB_SSL_CA is the PEM file used to verify the
# server certificate against the Supabase CA. Relative paths resolve against the
# project root. Without it, the pooler's private chain fails with
# "self-signed certificate in certificate chain".
DB_SSL_CA=certs/supabase-root-ca.crt

# DB_SSL only exists for local development: "false"/"disable" turns TLS off and
# "no-verify" keeps TLS but skips verification. Leave it unset for Supabase.
# DB_SSL=verify
