{
  "name": "staff-directory",
  "version": "1.0.0",
  "description": "Web-based staff directory system for browsing, searching and filtering staff information",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./public/assets/css/tailwind.css --minify",
    "test": "node --test",
    "db:init": "node src/database/seed.js",
    "db:seed": "node src/database/seed.js",
    "db:migrate:pg": "node scripts/migrate-sqlite-to-postgres.js"
  },
  "keywords": [
    "staff",
    "directory",
    "express",
    "sqlite"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "tailwindcss": "3.4.17"
  }
}
